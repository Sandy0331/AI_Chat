<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <title>流式输出测试</title>
</head>
<body>
    <h2>大模型回答：</h2>
    <!-- 这个 div 就是用来装文字的容器，id 叫 out -->
    <div id="out" style="border: 1px solid #ccc; padding: 10px; min-height: 100px; white-space: pre-wrap;"></div>

    <button onclick="startAsk()">发送请求测试流式</button>

    <script>
        async function startAsk(){
            //1. 发送POST请求给FastAPI
            const resp = await fetch('/ask_stream',{
                method: 'POST',
                headers:{'Content-Type': 'application/json'},
                body: JSON.stringify({question: "加班怎么算"})
            });
            //2. 获取读取器
            const reader = resp.body.getReader();
            const decoder = new TextDecoder();
            //3. 循环读取流
            while (true){
                const{done, value} = await reader.read();
                if(done) break;       // 读完了，跳出循环
                // 这段字节解码成文字
                const text = decoder.decode(value);
                // 追加到页面上
                document.getElementById('out').textContent += text;
            }
        }
    </script>
</body>
</html>